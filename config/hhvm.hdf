PidFile = /var/run/hhvm/pid
Server {
  Port = 9000
  Type = fastcgi
  ThreadCount = 10
  SourceRoot = /var/www
  EnableEarlyFlush = true
  ForceChunkedEncoding = true
  DefaultDocument = index.php
}

Repo {
  Central {
    Path = /var/desman/data/hhvm.cache
  }
}

Eval {
  Jit = true
  CheckFlushOnUserClose = true
}

Log {
  Level = Verbose
  UseLogFile = true
  File = /var/log/hhvm/error.log
  Access {
    * {
      File = /var/log/hhvm/access.log
      Format = %h %l %u %t "%r" %>s %b
    }
  }
}

VirtualHost {
  * {
    Pattern = .*
    RewriteRules {
      dirindex {
          pattern = ^/(.*)/?$
          to = $1/index.php
          qsa = true
        }
    }
  }
}

StaticFile {
  FilesMatch {
    * {
      pattern = .*.(dll|exe)
        headers {
          * = Content-Disposition: attachment
        }
    }
  }
  Extensions {
    js = text/javascript
    css = text/css
    gif = image/gif
    html = text/html
    jpe = image/jpeg
    jpeg = image/jpeg
    jpg = image/jpeg
    png = image/png
    tif = image/tiff
    tiff = image/tiff
    txt = text/plain
  }
}
